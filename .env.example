# Added automatically when you connect Upstash for Redis from the Vercel Storage tab
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Required: a long random string that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated emails that can feature games and remove anything (moderators)
ADMIN_EMAILS=you@example.com
