# Required: the Firebase service account key for project samurai-10ad7, so the server can use
# Firestore and Firebase Auth. Firebase console → Project settings → Service accounts →
# Generate new private key, then paste the whole JSON file's contents here (one line is fine).
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated emails that can feature games and remove anything (moderators).
# They only count once Firebase has verified the email (Google sign-in is verified).
ADMIN_EMAILS=you@example.com
